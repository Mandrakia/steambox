#!/usr/bin/env bash
# Hook systemd-sleep : délègue à /usr/libexec/steambox-av.
# Au resume on détache via systemd-run pour ne pas bloquer la sortie de veille
# (la boucle anti-course YSP peut durer ~10 s).
case "${1:-}" in
  pre)
    /usr/libexec/steambox-av suspend
    ;;
  post)
    systemd-run --collect --unit=steambox-av-resume /usr/libexec/steambox-av resume
    ;;
esac
exit 0
