# Steambox — paramètres du contrôle AV réseau (TV Samsung + barre Yamaha).
# Ce fichier est dans /etc : modifiable après install, survit aux mises à jour.
# Tant que TV_IP/TV_MAC sont vides, le contrôle TV est simplement sauté (pas d'erreur).

# TV Samsung QE65Q80T — IP fixe (réservation DHCP) et MAC (pour Wake-on-LAN)
TV_IP=""
TV_MAC=""

# Barre Yamaha YSP-2700 (MusicCast / API YXC)
YSP_IP="192.168.1.131"

# Entrée HDMI de la YSP où arrive l'adaptateur DP->HDMI du GPU (hdmi1/hdmi2/hdmi3)
YSP_INPUT="hdmi1"

# Au suspend : "handoff" = rebasculer la YSP sur l'entrée tv (la box reprend la main)
#              puis standby ; "off" = standby direct sans changer d'entrée.
SUSPEND_POLICY="handoff"

# Éteindre aussi la TV au suspend ? "yes" = tout s'éteint (mode console pur) ;
# "no" = la TV reste allumée (tu repasses sur la box à la télécommande).
TV_OFF_ON_SUSPEND="yes"
